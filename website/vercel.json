{
  "headers": [
    {
      "source": "/download/(.*)\\.dmg",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-diskimage" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Pebble.dmg\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
